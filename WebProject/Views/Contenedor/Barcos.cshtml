@{
    ViewData["Title"] = "Barcos por contenedor";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="mb-2">Barcos por contenedor</h1>
        <p class="text-muted">
            Ingresá el identificador del contenedor.
            Cada barco aparece una sola vez, ordenado por capacidad de carga de mayor a menor.
        </p>

        <form asp-action="Barcos" method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="id">Identificador</label>
                <input class="form-control" type="number" id="id" name="id" min="1" value="@ViewBag.Id" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
        </form>

        @if (ViewBag.Barcos != null)
        {
            <h2 class="h4 mt-4">Resultado del contenedor @ViewBag.Id</h2>
            @if (ViewBag.Barcos.Count == 0)
            {
                <p class="text-muted">Ningún barco transportó ese contenedor.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Capacidad de carga</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Dominio.Barco barco in ViewBag.Barcos)
                        {
                            <tr>
                                <td>@barco.Id</td>
                                <td>@barco.Nombre</td>
                                <td>@barco.CapacidadCarga</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>
